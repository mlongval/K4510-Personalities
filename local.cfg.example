# Copy to local.cfg (not tracked) and point it at your own files.  Sourced by
# tools/make-images.sh, tools/curate-c64.sh, tools/deploy-dell.sh and
# tools/build-k4532.sh.
# Kickstart ROMs and Workbench disks are copyrighted: bring your own (e.g.
# Amiga Forever).

KS13="$HOME/Amiga/kick13-a500.rom"        # Kickstart 1.3 (34.5), A500, crc c4f0f55f
KS31="$HOME/Amiga/kick31-a1200.rom"       # Kickstart 3.1 (40.68), A1200, crc 1483a091
WB="$HOME/Amiga/Workbench"                # amiga-os-134-*.adf and amiga-os-310-*.adf
GAMES="$HOME/Amiga/Floppies"              # optional: more .adf for the A500

# Optional: a C64 collection for tools/curate-c64.sh (a TOSEC C64 set under
# Commodore64/C64-Ultimate-Software-Collection/, see the script).
C64_COLLECTION="$HOME/Emulation"

# The K4510 machine tools/deploy-dell.sh copies to.
DEPLOY_HOST="k4510@k4510.local"

# The K4532 personality (tools/build-k4532.sh): which commit of K4532 to
# build, where to clone it from, and where its k4510 submodule comes from.
K4532_REF="a34e72c"
K4532_REPO="$HOME/Projects/K4532"
K4510_MIRROR="https://github.com/mlongval/k4510.git"
