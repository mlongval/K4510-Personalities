#!/bin/sh
# Start one VICE personality: run/<name> is a link to this file.
# Runs from the image k4510-personality mounted at /opt/personalities/vice.
# Saved things live in ~/personalities/<name> (the disk, p4); VICE's own
# settings in ~/.config/vice/vicerc (F12 -> Settings -> Save).
V=/opt/personalities/vice
name=$(basename "$0")
# The placement every personality shares: ~/personalities/display.cfg,
# placement=left|centre, scale=fit|integer, sidebar=NAME (the X16's F12
# menu writes it), vdcborders=on|off (the C128's).
C=$HOME/personalities/display.cfg
if [ -f "$C" ]; then
    v=$(sed -n 's/^placement=//p' "$C"); [ -n "$v" ] && export K4510_PLACEMENT=${K4510_PLACEMENT:-$v}
    v=$(sed -n 's/^scale=//p' "$C"); [ -n "$v" ] && export K4510_SCALE=${K4510_SCALE:-$v}
    v=$(sed -n 's/^sidebar=//p' "$C"); [ -n "$v" ] && [ -z "$K4510_SIDEBAR" ] && export K4510_SIDEBAR="$v state=$HOME/personalities/sidebar"
    v=$(sed -n 's/^vdcborders=//p' "$C"); [ -n "$v" ] && export K4510_VDC_BORDERS=${K4510_VDC_BORDERS:-$v}
fi
export K4510_DISPLAY_CFG=$C   # the C128's F12 -> Video settings -> VDC borders writes vdcborders= here
# The K4510's sidebar scenes (its layer builds the library); sidebar=NAME in
# display.cfg picks one: antfarm matrix space river dreamfall tetris
# halloween christmas, or none.
# the K4532's scenes (its library; ~/k4510/sdl/libk4510side.so before the names pass, 2026-10-12)
for l in "$HOME/k4532/sdl/libk4532side.so" "$HOME/k4510/sdl/libk4510side.so"; do
    [ -z "$K4510_SIDEBAR_LIB" ] && [ -f "$l" ] && export K4510_SIDEBAR_LIB=$l
done
mkdir -p "$HOME/personalities/sidebar"
export LD_LIBRARY_PATH=$V/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
D=$HOME/personalities/$name; mkdir -p "$D"; cd "$D" || exit 1
# Fullscreen on the KMS display, sound through ALSA (mixed by dmix like the
# K4510's), and the keyboard by symbol: a PC key types what is printed on it
# (Doc, 2026-10-17; -keymap 1 laid the C64's out by position until then).
common="-sounddev alsa -keymap 0"
# The REU, 16 MB (VICE's largest; Doc asked for 64): PETSCII Robots' REU
# edition and GEOS use it, and it is harmless to the rest.
reu="-reu -reusize 16384"
# The SD volume: drive 9 is a folder, ~/personalities/SD, shared by the C64
# and the C128 -- VICE's filesystem device, which takes SD2IEC's CD commands
# -- with Dir Browser on it (DB64, DB128; the sidebar's BROWSE runs it).
SD=$HOME/personalities/SD; mkdir -p "$SD"
for f in DB64 DB128; do [ -f "$SD/$f" ] || [ ! -f "$V/share/dirbrowser/$f" ] || cp "$V/share/dirbrowser/$f" "$SD/$f"; done
export K4510_SD=$SD
sd="-drive9type 0 -busdevice9 -devicebackend9 1 -fs9 $SD"
case "$name" in
c64)  exec $V/bin/x64sc $common -VICIIfull $reu $sd -kernal kernal-k4532.bin "$@" ;;   # the KERNAL's power-on colours: white on dark blue (make-images.sh)
c128) exec $V/bin/x128  $common -VICIIfull -VDCfull $reu $sd "$@" ;;
pet)  exec $V/bin/xpet  $common -keymap 1 -model 4032 -CRTCfull "$@" ;;   # 40 columns, 32K: what most PET games (PETSCII Robots) want
*)    echo "vice: no personality called $name"; exit 1 ;;
esac
