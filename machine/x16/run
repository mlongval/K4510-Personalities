#!/bin/sh
# Start the Commander X16 personality (x16emu r49): this is run/x16.
# Runs from the image k4510-personality mounted at /opt/personalities/x16.
#
# F12: the menu (BMC64Port's patch) -- Resume, Reset, Warp, Placement
# (centre, or flush left with the right free for a sidebar), Scale (fit or
# whole multiples), Exit to the K4510.  Also quitting: Alt+F4, or POWEROFF at
# the BASIC prompt (the X16's own power-off).  Ctrl+R resets.
#
# Saved things live in ~/personalities/x16 (the disk, p4): the directory is
# the X16's drive 8 (HostFS: LOAD/SAVE/DOS"$" read and write plain files
# there), nvram.bin keeps the clock's NVRAM.  An sdcard.img put there is used
# instead of the directory.
X=/opt/personalities/x16
export K4510_X16_SETTINGS=$HOME/personalities/display.cfg   # placement, shared with the others
# The placement every personality shares: ~/personalities/display.cfg,
# placement=left|centre, scale=fit|integer, sidebar=NAME (the X16's F12
# menu writes it).
C=$HOME/personalities/display.cfg
if [ -f "$C" ]; then
    v=$(sed -n 's/^placement=//p' "$C"); [ -n "$v" ] && export K4510_PLACEMENT=${K4510_PLACEMENT:-$v}
    v=$(sed -n 's/^scale=//p' "$C"); [ -n "$v" ] && export K4510_SCALE=${K4510_SCALE:-$v}
    v=$(sed -n 's/^sidebar=//p' "$C"); [ -n "$v" ] && [ -z "$K4510_SIDEBAR" ] && export K4510_SIDEBAR="$v state=$HOME/personalities/sidebar"
fi
# The K4510's sidebar scenes (its layer builds the library); sidebar=NAME in
# display.cfg picks one: antfarm matrix space river dreamfall tetris
# halloween christmas, or none.
[ -z "$K4510_SIDEBAR_LIB" ] && [ -f "$HOME/k4510/sdl/libk4510side.so" ] && export K4510_SIDEBAR_LIB=$HOME/k4510/sdl/libk4510side.so
mkdir -p "$HOME/personalities/sidebar"
export LD_LIBRARY_PATH=$X/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
D=$HOME/personalities/x16; mkdir -p "$D"; cd "$D" || exit 1
# Fullscreen on the KMS display; under X (a test, a desktop) a window.
[ -n "$DISPLAY" ] || set -- -fullscreen "$@"
set -- -rom $X/rom.bin -nvram "$D/nvram.bin" -rtc "$@"
[ -f "$D/sdcard.img" ] && set -- -sdcard "$D/sdcard.img" "$@" || set -- -fsroot "$D" "$@"
exec $X/bin/x16emu "$@"
