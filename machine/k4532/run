#!/bin/sh
# Start the K4532 personality: this is run/k4532.  The K4510 with a 4532
# CPU mode (RISC-V RV32IMFD; the K4532 repo), from the image
# k4510-personality mounted at /opt/personalities/k4532.
#
# The same emulator as the K4510's, run the way k4510-session runs that one
# (from its own directory, full screen on tty1's KMS display), but with a
# directory of its own: ~/personalities/k4532 (p4), holding
#   fs/                 its disk -- K/OS's files, K32 and the 4532 programs
#                       (/APPS/DEMOS), and a STARTUP.BAT that says hello
#   k4510.cfg           its settings (the F12 menu's), started from the
#   k4510-menu.cfg      K4510's own on the first run, its own after that
#   k4510-slot*.k4s     the save states; k4510-resume.k4s, Save and power off
#   shots/              screenshots
#   data tube tools     links into the image (the fonts, the Tube's BASIC,
#                       the compilers' scripts: the Tube puts tools/ on PATH)
#
# The disk: on the first run the image's fs/ is copied in whole.  After
# that, when a newer image ships (its fs.sha256 differs from .shipped, the
# list of what was shipped last), a file new to the image is copied in if
# the name is free; a file the image changed replaces yours only if yours
# is still the one shipped before (unedited); a shipped file you deleted
# stays deleted; a shipped file the image no longer has goes if yours is
# still the one shipped (moved or retired, e.g. the 2026-10-12 tidy), and
# so does its folder if that leaves it empty.  Your own files are never
# touched.
#
# Quitting: F12 > Machine > Quit the emulator (back to the Chooser), or
# Power off / Save and power off (the machine goes off, as from the K4510).
X=/opt/personalities/k4532
D=$HOME/personalities/k4532
mkdir -p "$D/fs" "$D/shots" || exit 1
for l in data tube tools; do
    { [ -L "$D/$l" ] || [ ! -e "$D/$l" ]; } && ln -sfn "$X/$l" "$D/$l"
done

# the disk: what the image ships that is not there yet (see above)
S=$D/.shipped
if ! cmp -s "$X/fs.sha256" "$S"; then
    awk -v oldf="$S" 'BEGIN { while ((getline l < oldf) > 0) old[substr(l, 67)] = substr(l, 1, 64) }
        { p = substr($0, 67); print $1, (p in old ? old[p] : "-"), p }' "$X/fs.sha256" |
    while read -r new old p; do
        f=$D/fs/${p#./}; src=$X/fs/${p#./}
        if [ "$old" = - ]; then
            [ -e "$f" ] || { mkdir -p "${f%/*}" && cp "$src" "$f"; }
        elif [ "$new" != "$old" ] && [ -f "$f" ] && [ "$(sha256sum < "$f" | cut -c1-64)" = "$old" ]; then
            cp "$src" "$f.new" && mv "$f.new" "$f"
        fi
    done
    # the few links (CP/M's drives): made where the name is free
    (cd "$X/fs" && find . -type l) | while read -r p; do
        f=$D/fs/${p#./}
        [ -e "$f" ] || [ -L "$f" ] || { mkdir -p "${f%/*}" && cp -P "$X/fs/${p#./}" "$f"; }
    done
    # what the image dropped: removed where it is still the copy shipped
    [ ! -f "$S" ] || awk 'NR == FNR { now[substr($0, 67)] = 1; next }
        !(substr($0, 67) in now) { print substr($0, 1, 64), substr($0, 67) }' "$X/fs.sha256" "$S" |
    while read -r old p; do
        f=$D/fs/${p#./}
        [ -f "$f" ] && [ ! -L "$f" ] && [ "$(sha256sum < "$f" | cut -c1-64)" = "$old" ] || continue
        rm -f "$f"; d=${f%/*}
        while [ "$d" != "$D/fs" ] && rmdir "$d" 2>/dev/null; do d=${d%/*}; done
    done
    cp "$X/fs.sha256" "$S"
fi

# its settings: the K4510's as they stand the first time (the CPU clock
# SETUP measured, the keyboard layout, the locks), its own after that
for c in k4510.cfg k4510-menu.cfg; do
    [ -f "$D/$c" ] || [ ! -f "$HOME/k4510/$c" ] || cp "$HOME/k4510/$c" "$D/$c"
done
[ -f "$D/k4510.cfg" ] || printf 'version = 3\ncpu.auto = on\nterm.bands = on\nvideo.fullscreen = on\n' > "$D/k4510.cfg"

# K/OS from power-on: the K4532's ROM is K/OS itself (rom/kos.k32; the
# 4510 is gone from the machine, K4532's PLAN.md step 3).
# PAS and CC: the compilers in the image (k4532-pas, k4532-cc run on this
# Linux through the Tube; GCC for RISC-V and Free Pascal's cross-compiler)
export PATH=$X/rvgcc/bin:$PATH K4532_FPC=$X/fpc
unset K4510
export LD_LIBRARY_PATH=$X/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
cd "$D" || exit 1
exec "$X/bin/k4532" "$X/rom/kos.k32" fs "$@"
